# 範本，未啟用（副檔名 .example，GitHub 不會執行）。啟用方式見 docs/research/release-plan.md。
# 設計重點：
#   - 發布關卡＝部署前的 strict 驗證：研究文章必須有站長簽章的核准 tag，否則整次部署失敗、網站維持舊版
#   - 小說章節排程不受影響：schedule-chapters.yml 用內建權杖推 main，那種推送不會觸發其他工作流程，
#     所以這裡另外用 workflow_run 在「排程發章」跑完後部署（不需要改 schedule-chapters.yml）
#   - 一般推送 main、手動按，也會部署
name: 部署網站（研究文章需站長簽章核准）
on:
  push:
    branches: [main]
  workflow_run:
    workflows: ["排程發章"]
    types: [completed]
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: pages
  cancel-in-progress: false
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with: { ref: main, fetch-depth: 0, fetch-tags: true, persist-credentials: false }
      - run: ruby .github/scripts/validate_literature.rb .
      - run: ruby .github/scripts/validate_research.rb .
      - run: ruby .github/scripts/verify_approvals.rb . --strict
      - uses: actions/jekyll-build-pages@v1
        with: { source: ./, destination: ./_site }
      - uses: actions/upload-pages-artifact@v3
  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.d.outputs.page_url }}
    steps:
      - id: d
        uses: actions/deploy-pages@v4
