---
layout: null
sitemap: false
---
{
  "version": 1,
  "generated_at": {{ site.time | date_to_xmlschema | jsonify }},
  "chapters": {
  {%- for p in site.posts %}
    {{ p.url | relative_url | jsonify }}: {
      "url": {{ p.url | relative_url | jsonify }},
      "novel": {{ p.novel | jsonify }},
      "chapter": {{ p.chapter | default: 0 | jsonify }},
      "character": {{ p.character | jsonify }},
      "title": {{ p.title | jsonify }},
      "status": "published"
    }{% unless forloop.last %},{% endunless %}
  {%- endfor %}
  },
  "withdrawn": {
  {%- for w in site.data.withdrawn.urls %}
    {{ w.url | jsonify }}: {
      "status": "withdrawn",
      "level": {{ w.level | jsonify }},
      "date": {{ w.date | date: '%Y-%m-%d' | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor %}
  },
  "remaps": {}
}
